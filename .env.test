# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# SQLite: the doctrine "dbname_suffix" option has no effect on SQLite, so the
# test environment must point to its own database file to avoid wiping dev data.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_test.db"
# Never send real emails in tests: the mailer assertion collector still sees them.
MAILER_DSN="null://null"
