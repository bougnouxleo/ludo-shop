<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Facture {{ invoice.number }} — LudoShop</title>
    <style>
        body { font-family: sans-serif; color: #222; max-width: 800px; margin: 0 auto; padding: 2rem; }
        h1 { font-size: 1.5rem; margin-bottom: 0.25rem; }
        .header { display: flex; justify-content: space-between; margin-bottom: 2rem; }
        .meta { color: #666; font-size: 0.875rem; }
        table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; }
        th, td { padding: 0.5rem; border-bottom: 1px solid #ddd; text-align: left; }
        tfoot th { border-top: 2px solid #333; }
        .text-right { text-align: right; }
        .text-center { text-align: center; }
        .note { color: #666; font-size: 0.75rem; margin-top: 2rem; }
        @media print {
            body { padding: 0; }
            .no-print { display: none; }
        }
    </style>
</head>
<body>
    <div class="header">
        <div>
            <h1>LudoShop</h1>
            <div class="meta">Facture {{ invoice.number }}</div>
        </div>
        <div class="text-right">
            <div class="meta">Émise le {{ invoice.issuedAt|date('d/m/Y H:i') }}</div>
            <div class="meta">Commande {{ invoice.order.number }}</div>
        </div>
    </div>

    <div class="mb-4">
        <strong>Adressée à</strong><br>
        {{ invoice.user.fullName }}<br>
        {{ invoice.order.addressLine }}<br>
        {{ invoice.order.postalCode }} {{ invoice.order.city }}<br>
        {{ invoice.order.country }}
    </div>

    <table>
        <thead>
        <tr>
            <th>Produit</th>
            <th class="text-right">Prix unitaire</th>
            <th class="text-center">Quantité</th>
            <th class="text-right">Total</th>
        </tr>
        </thead>
        <tbody>
        {% for item in order.items %}
            <tr>
                <td>{{ item.productName }}</td>
                <td class="text-right">{{ item.unitPrice|number_format(2, ',', ' ') }} €</td>
                <td class="text-center">{{ item.quantity }}</td>
                <td class="text-right">{{ item.lineTotal|number_format(2, ',', ' ') }} €</td>
            </tr>
        {% endfor %}
        </tbody>
        <tfoot>
        <tr>
            <th colspan="3" class="text-right">Total HT</th>
            <th class="text-right">{{ invoice.totalHt|number_format(2, ',', ' ') }} €</th>
        </tr>
        <tr>
            <th colspan="3" class="text-right">TVA ({{ invoice.vatRate|number_format(0, ',', ' ') }} %)</th>
            <th class="text-right">{{ (invoice.totalTtc - invoice.totalHt)|number_format(2, ',', ' ') }} €</th>
        </tr>
        <tr>
            <th colspan="3" class="text-right">Total TTC</th>
            <th class="text-right">{{ invoice.totalTtc|number_format(2, ',', ' ') }} €</th>
        </tr>
        </tfoot>
    </table>

    <p class="note">Paiement simulé à des fins pédagogiques. Cette facture est immuable.</p>

    <div class="no-print mt-4 text-center">
        <button onclick="window.print()" class="btn btn-primary">Imprimer</button>
        <a href="{{ path('app_invoice_show', {'id': order.id}) }}" class="btn btn-outline-secondary">Retour</a>
    </div>
</body>
</html>
