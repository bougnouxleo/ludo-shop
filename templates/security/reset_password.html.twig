{% extends 'base.html.twig' %}

{% block title %}Réinitialisation du mot de passe — LudoShop{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card auth-card shadow-sm">
                <div class="card-body">
                    <h1 class="h4 mb-4">Nouveau mot de passe</h1>
                    {{ form_start(form) }}
                    {{ form_row(form.plainPassword) }}
                    <button type="submit" class="btn btn-primary w-100 mt-2">Réinitialiser le mot de passe</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
