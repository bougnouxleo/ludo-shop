{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié — LudoShop{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card auth-card shadow-sm">
                <div class="card-body">
                    <h1 class="h4 mb-4">Mot de passe oublié</h1>
                    <p class="text-muted">
                        Saisissez votre adresse e-mail : si un compte existe, nous vous enverrons un lien de
                        réinitialisation (valable 2 heures).
                    </p>
                    {{ form_start(form) }}
                    {{ form_row(form.email) }}
                    <button type="submit" class="btn btn-primary w-100 mt-2">Envoyer le lien</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
