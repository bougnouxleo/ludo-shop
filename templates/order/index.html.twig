{% extends 'base.html.twig' %}

{% block title %}Mes commandes — LudoShop{% endblock %}

{% block body %}
    <h1 class="h3 mb-4">Mes commandes</h1>

    {% if orders|length == 0 %}
        <div class="alert alert-info">Vous n'avez pas encore de commande.</div>
        <a href="{{ path('app_catalog') }}" class="btn btn-primary">Découvrir le catalogue</a>
    {% else %}
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                <tr>
                    <th>N°</th>
                    <th>Date</th>
                    <th>Statut</th>
                    <th class="text-end">Total</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% for order in orders %}
                    <tr>
                        <td>{{ order.number }}</td>
                        <td>{{ order.createdAt|date('d/m/Y H:i') }}</td>
                        <td><span class="badge bg-secondary">{{ order.status.label }}</span></td>
                        <td class="text-end">{{ order.totalAmount|number_format(2, ',', ' ') }} €</td>
                        <td class="text-end">
                            <a href="{{ path('app_order_show', {'id': order.id}) }}" class="btn btn-sm btn-outline-primary">Détail</a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
