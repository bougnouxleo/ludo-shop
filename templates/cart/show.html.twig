{% extends 'base.html.twig' %}

{% block title %}Panier — LudoShop{% endblock %}

{% block body %}
    <h1 class="h3 mb-4">Votre panier</h1>

    {% if cart.items|length == 0 %}
        <div class="alert alert-info">Votre panier est vide.</div>
        <a href="{{ path('app_catalog') }}" class="btn btn-primary">Découvrir le catalogue</a>
    {% else %}
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                <tr>
                    <th>Produit</th>
                    <th>Prix unitaire</th>
                    <th class="text-center">Quantité</th>
                    <th class="text-end">Total</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% for item in cart.items %}
                    <tr>
                        <td>
                            <a href="{{ path('app_product_show', {'id': item.product.id}) }}">{{ item.product.name }}</a>
                        </td>
                        <td>{{ item.unitPrice|number_format(2, ',', ' ') }} €</td>
                        <td class="text-center">
                            <input type="number"
                                   value="{{ item.quantity }}"
                                   min="1"
                                   max="{{ item.product.stock }}"
                                   class="form-control form-control-sm js-cart-quantity"
                                   style="width: 90px;"
                                   data-url="{{ path('app_cart_update_json', {'id': item.id}) }}"
                                   data-max="{{ item.product.stock }}"
                                   aria-label="Quantité de {{ item.product.name }}"
                                   aria-describedby="quantity-feedback-{{ item.id }}">
                            <div id="quantity-feedback-{{ item.id }}" class="js-quantity-feedback invalid-feedback" hidden></div>
                        </td>
                        <td class="text-end js-line-total">{{ item.lineTotal|number_format(2, ',', ' ') }} €</td>
                        <td class="text-end">
                            <form method="post" action="{{ path('app_cart_remove', {'id': item.id}) }}" onsubmit="return confirm('Retirer ce produit du panier ?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Retirer</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
                <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Total TTC</th>
                    <th class="text-end" id="cart-total">{{ total|number_format(2, ',', ' ') }} €</th>
                    <th></th>
                </tr>
                </tfoot>
            </table>
            <p id="cart-total-live" class="visually-hidden" aria-live="polite"></p>
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <form method="post" action="{{ path('app_cart_clear') }}" onsubmit="return confirm('Vider le panier ?');">
                <button type="submit" class="btn btn-outline-danger">Vider le panier</button>
            </form>
            <a href="{{ path('app_checkout') }}" class="btn btn-primary btn-lg">Passer commande</a>
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    <script type="module" src="{{ asset('js/cart.js') }}"></script>
{% endblock %}
