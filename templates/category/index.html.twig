{% extends 'base.html.twig' %}

{% block title %}Catégories — LudoShop{% endblock %}

{% block body %}
    <h1 class="h3 mb-4">Catégories</h1>

    <div class="row g-4">
        {% for category in categories %}
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <a href="{{ path('app_category_show', {'slug': category.slug}) }}" class="text-decoration-none">
                    <div class="card h-100 shadow-sm category-card">
                        <div class="card-body d-flex flex-column">
                            <h2 class="card-title h5">{{ category.name }}</h2>
                            <p class="card-text text-muted mt-auto">
                                {{ counts[category.id] }} {{ counts[category.id] > 1 ? 'produits' : 'produit' }}
                            </p>
                        </div>
                    </div>
                </a>
            </div>
        {% else %}
            <p class="text-muted">Aucune catégorie disponible.</p>
        {% endfor %}
    </div>
{% endblock %}
