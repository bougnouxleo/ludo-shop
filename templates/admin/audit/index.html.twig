{% extends 'base.html.twig' %}

{% block title %}Journal d'audit — Administration LudoShop{% endblock %}

{% block body %}
    <h1 class="h3 mb-4">Journal d'audit</h1>

    <p class="text-muted small">
        Journal <strong>en lecture seule</strong> : les actions sensibles y sont enregistrées de façon
        inaltérable (utilisateur, action, horodatage).
    </p>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
            <tr>
                <th>Date</th>
                <th>Utilisateur</th>
                <th>Action</th>
                <th>Détails</th>
            </tr>
            </thead>
            <tbody>
            {% for entry in entries %}
                <tr>
                    <td>{{ entry.createdAt|date('d/m/Y H:i:s') }}</td>
                    <td>{{ entry.user.email }}</td>
                    <td><code>{{ entry.action }}</code></td>
                    <td><small class="text-muted">{{ entry.details|json_encode }}</small></td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="text-center text-muted">Aucune entrée dans le journal.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
