{% extends 'base.html.twig' %}

{% block title %}Commandes — Administration LudoShop{% endblock %}

{% block body %}
    <h1 class="h3 mb-4">Gestion des commandes</h1>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" action="{{ path('app_admin_orders') }}" class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label for="filterStatus" class="form-label">Statut</label>
                    <select name="status" id="filterStatus" class="form-select form-select-sm">
                        <option value="">Tous</option>
                        {% for status in statuses %}
                            <option value="{{ status.value }}" {% if filters.status == status.value %}selected{% endif %}>
                                {{ status.label }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="filterDateFrom" class="form-label">Date début</label>
                    <input type="date" name="dateFrom" id="filterDateFrom" class="form-control form-control-sm"
                           value="{{ filters.dateFrom ?? '' }}">
                </div>
                <div class="col-md-2">
                    <label for="filterDateTo" class="form-label">Date fin</label>
                    <input type="date" name="dateTo" id="filterDateTo" class="form-control form-control-sm"
                           value="{{ filters.dateTo ?? '' }}">
                </div>
                <div class="col-md-2">
                    <label for="filterClient" class="form-label">Client</label>
                    <input type="text" name="client" id="filterClient" class="form-control form-control-sm"
                           placeholder="Nom ou email" value="{{ filters.client ?? '' }}">
                </div>
                <div class="col-md-2">
                    <label for="filterNumber" class="form-label">N° commande</label>
                    <input type="text" name="number" id="filterNumber" class="form-control form-control-sm"
                           placeholder="CMD-..." value="{{ filters.number ?? '' }}">
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm">Filtrer</button>
                    <a href="{{ path('app_admin_orders') }}" class="btn btn-outline-secondary btn-sm">Réinitialiser</a>
                </div>
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="text-muted mb-0">{{ orders|length }} commande(s) trouvée(s)</p>
        <form method="post" action="{{ path('app_admin_orders_export') }}">
            {% for key, value in filters %}
                {% if value %}
                    <input type="hidden" name="{{ key }}" value="{{ value }}">
                {% endif %}
            {% endfor %}
            <button type="submit" class="btn btn-outline-success btn-sm">Exporter CSV</button>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
            <tr>
                <th>N°</th>
                <th>Client</th>
                <th>Date</th>
                <th>Statut</th>
                <th class="text-end">Total</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            {% for order in orders %}
                <tr>
                    <td>{{ order.number }}</td>
                    <td>{{ order.user.fullName }}</td>
                    <td>{{ order.createdAt|date('d/m/Y H:i') }}</td>
                    <td><span class="badge bg-secondary">{{ order.status.label }}</span></td>
                    <td class="text-end">{{ order.totalAmount|number_format(2, ',', ' ') }} €</td>
                    <td class="text-end">
                        <a href="{{ path('app_admin_order_show', {'id': order.id}) }}" class="btn btn-sm btn-outline-primary">Détail</a>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="text-center text-muted">Aucune commande.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
