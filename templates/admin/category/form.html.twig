{% extends 'base.html.twig' %}

{% block title %}{{ category.id ? 'Modifier' : 'Nouvelle' }} catégorie — Admin{% endblock %}

{% block body %}
    <h1 class="h3 mb-4">{{ category.id ? 'Modifier' : 'Nouvelle' }} catégorie</h1>

    <div class="card" style="max-width: 600px;">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_rest(form) }}
                <button type="submit" class="btn btn-primary mt-3">
                    {{ category.id ? 'Enregistrer' : 'Créer' }}
                </button>
                <a href="{{ path('app_admin_categories') }}" class="btn btn-link mt-3">Annuler</a>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
