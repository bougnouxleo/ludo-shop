{% extends 'base.html.twig' %}

{% block title %}Mon compte — LudoShop{% endblock %}

{% block body %}
    <h1 class="h3 mb-4">Mon compte</h1>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h6">Informations personnelles</h2>
                    <p class="mb-1"><strong>E-mail :</strong> {{ user.email }}</p>
                    <p class="mb-3"><strong>Inscrit le :</strong> {{ user.createdAt|date('d/m/Y') }}</p>

                    <a href="{{ path('app_address_index') }}" class="btn btn-outline-primary mb-3">Mes adresses</a>

                    {{ form_start(profileForm, {'action': path('app_account_profile'), 'attr': {'class': 'needs-validation'}}) }}
                        {{ form_row(profileForm.firstName) }}
                        {{ form_row(profileForm.lastName) }}
                        {{ form_row(profileForm.birthDate) }}
                        <button type="submit" class="btn btn-primary">Modifier mon profil</button>
                    {{ form_end(profileForm) }}
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h6">Changer de mot de passe</h2>
                    {{ form_start(passwordForm, {'action': path('app_account_password'), 'attr': {'class': 'needs-validation'}}) }}
                        {{ form_row(passwordForm.currentPassword) }}
                        {{ form_row(passwordForm.plainPassword) }}
                        <button type="submit" class="btn btn-primary">Changer le mot de passe</button>
                    {{ form_end(passwordForm) }}
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h6">Newsletter</h2>
                    <p class="text-muted small mb-2">
                        {% if user.newsletterSubscribed %}
                            Vous êtes actuellement abonné à la newsletter.
                        {% else %}
                            Vous n'êtes pas abonné à la newsletter.
                        {% endif %}
                    </p>
                    <form method="post" action="{{ path('app_account_newsletter_toggle') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('newsletter_toggle') }}">
                        <button type="submit" class="btn btn-outline-primary btn-sm">
                            {% if user.newsletterSubscribed %}Se désabonner{% else %}S'abonner{% endif %}
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-danger">
                <div class="card-body">
                    <h2 class="h6 text-danger">Zone sensible</h2>
                    <p class="text-muted small">
                        La suppression de votre compte est définitive et irréversible.
                    </p>
                    <form method="post" action="{{ path('app_account_delete') }}"
                          onsubmit="return confirm('Confirmer la suppression définitive de votre compte ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_account') }}">
                        <button type="submit" class="btn btn-outline-danger">Supprimer mon compte</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
