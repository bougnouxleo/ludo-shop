{% extends 'base.html.twig' %}

{% block title %}LudoShop — Votre boutique de jeux de société{% endblock %}

{% block body %}
    <div class="hero p-5 mb-5">
        <h1 class="display-5 fw-bold">LudoShop</h1>
        <p class="lead mb-4">La boutique en ligne des passionnés de jeux de société.</p>
        <a href="{{ path('app_catalog') }}" class="btn btn-amber btn-lg">Voir le catalogue</a>
    </div>

    <h2 class="h4 mb-4">Nouveautés</h2>
    <div class="row g-4">
        {% for product in products %}
            <div class="col-12 col-sm-6 col-md-4 col-lg-2">
                <div class="card h-100 product-card">
                    <div class="position-relative">
                        {% if product.image %}
                            <img src="{{ product.image }}" class="card-img-top" alt="{{ product.name }}">
                        {% else %}
                            <img src="https://placehold.co/600x400?text=LudoShop" class="card-img-top" alt="{{ product.name }}">
                        {% endif %}
                        {% if product.isMature %}
                            <span class="badge bg-dark position-absolute top-0 start-0 m-2">+18</span>
                        {% endif %}
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h3 class="card-title h6">{{ product.name }}</h3>
                        <p class="text-muted small flex-grow-1">{{ product.publisher ?? '' }}</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="price">{{ product.price|number_format(2, ',', ' ') }} €</span>
                            <a href="{{ path('app_product_show', {'id': product.id}) }}" class="btn btn-sm btn-outline-primary">Voir</a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <p class="text-muted">Aucun produit pour le moment.</p>
        {% endfor %}
    </div>
{% endblock %}
