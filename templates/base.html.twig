<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{% block title %}LudoShop{% endblock %}</title>
    <script>
        (function(){var t=localStorage.getItem('theme');if(!t){t=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}document.documentElement.setAttribute('data-theme',t);})();
    </script>
    <link rel="stylesheet" href="{{ asset('styles/app.scss') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">
            <span class="brand-mark" aria-hidden="true"></span>
            LudoShop
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_catalog') }}">Catalogue</a>
                </li>
                {% if app.user %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_orders') }}">Mes commandes</a>
                    </li>
                {% endif %}
            </ul>
            <ul class="navbar-nav">
                <li class="nav-item">
                    <button class="theme-toggle" type="button" aria-label="Changer de thème" title="Changer de thème">
                        <span class="icon-moon" aria-hidden="true">&#9790;</span>
                        <span class="icon-sun" aria-hidden="true">&#9788;</span>
                    </button>
                </li>
                {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" role="button">Admin</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="{{ path('app_admin_products') }}">Produits</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_admin_orders') }}">Commandes</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_admin_reviews') }}">Avis</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_admin_users') }}">Utilisateurs</a></li>
                        </ul>
                    </li>
                {% endif %}
                {% if app.user %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_cart') }}">
                            Panier
                            {% if cart_count() > 0 %}
                                <span class="badge bg-warning text-dark rounded-pill" id="cart-count-badge">{{ cart_count() }}</span>
                            {% endif %}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_wishlist') }}">Wishlist</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_account') }}">{{ app.user.fullName }}</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_logout') }}">Déconnexion</a>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_login') }}">Connexion</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_register') }}">Inscription</a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

<main class="container my-4 flex-grow-1">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show js-flash" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</main>

<div class="toast-provider" id="toast-provider" aria-live="polite" aria-atomic="true"></div>

<footer class="site-footer py-4">
    <div class="container text-center small">
        LudoShop — Projet pédagogique (IUT) — Paiement simulé
    </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<script src="{{ asset('js/theme.js') }}"></script>
<script src="{{ asset('js/toast.js') }}"></script>
<script src="{{ asset('js/wishlist.js') }}"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
