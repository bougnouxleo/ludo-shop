{% extends 'base.html.twig' %}

{% block body %}
    <h1 class="h4 mb-3">Réinitialisation de votre mot de passe</h1>
    <p>Bonjour {{ user.fullName }},</p>
    <p>Vous avez demandé la réinitialisation de votre mot de passe. Cliquez sur le lien ci-dessous
       (valable 2 heures) :</p>
    <p>
        <a class="btn btn-primary" href="{{ resetUrl }}">Réinitialiser mon mot de passe</a>
    </p>
    <p class="text-muted small">
        Si vous n'êtes pas à l'origine de cette demande, vous pouvez ignorer cet e-mail.
    </p>
{% endblock %}
